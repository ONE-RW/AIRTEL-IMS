# ─────────────────────────────────────────────────────────
#  Central Server — Environment Variables
# ─────────────────────────────────────────────────────────

# Shared secret between server and all device agents
AGENT_API_KEY=changeme-secret-key-replace-this

# ── AI Provider — uncomment the one you want to use ──────

# Option A: Anthropic (Claude)
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Option B: OpenAI (GPT-4o)
# AI_PROVIDER=openai
# AI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Option C: DeepSeek
AI_PROVIDER=deepseek
AI_API_KEY=Your Deep SEEK API KEY HERE PLEASE REPLACE THIS

# ─────────────────────────────────────────────────────────

# Database
DATABASE_URL=sqlite:///device_health.db
# DATABASE_URL=postgresql://user:password@localhost:5432/device_health

# How many days of telemetry to retain
RETENTION_DAYS=30